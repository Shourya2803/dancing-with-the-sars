# ==========================================
# Dancing with the SARs - Environment Config
# ==========================================

# Application
DEBUG=False
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","*"]

# NASA Earthdata / CMR Search
NASA_CMR_SEARCH_URL=https://cmr.earthdata.nasa.gov/search/granules.json
NISAR_GCOV_COLLECTION_ID=C2854338529-ASF
NISAR_GUNW_COLLECTION_ID=C2854335566-ASF
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Supabase (PostgreSQL / PostGIS)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Cloudflare R2 Object Storage (S3 Compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=name
R2_PUBLIC_URL=https://pub-your-id.r2.dev

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
